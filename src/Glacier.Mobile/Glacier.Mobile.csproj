<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Mobile</PackageId>
    <Version>1.1.1</Version>
    <PackageReleaseNotes>v1.1.1: Cached PlotView framebuffer/canvas, SKPaint pooling, touch bubbling, PinchGestureRecognizer partial-lift tracking, SPSC CachedRemote ring buffer, and honest net10.0 headless scope.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>High-performance headless mobile UI, layout, and touch/gesture pipeline core for .NET 10 Native AOT. Zero-allocation touch ring buffer, SIMD gesture inertia kernels, and SkiaSharp software/swapchain composition core.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Mobile</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Mobile.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mobile;ui;gestures;touch;aot;nativeaot;skiasharp;headless;simd;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj" Condition="Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Polaris" Condition="!Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Plot/src/Glacier.Plot/Glacier.Plot.csproj" Condition="Exists('../../../Glacier.Plot/src/Glacier.Plot/Glacier.Plot.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Plot" Condition="!Exists('../../../Glacier.Plot/src/Glacier.Plot/Glacier.Plot.csproj') or '$(UseLocalProjectReferences)' == 'false'" />
  </ItemGroup>
</Project>
